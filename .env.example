# MongoDB Atlas Connection Configuration
# Replace with your MongoDB Atlas connection string:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/credit_scoring_db?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/credit_scoring_db
DB_NAME=credit_scoring_db
COLLECTION_NAME=credit_assessments

# Flask Server Port
PORT=5000
